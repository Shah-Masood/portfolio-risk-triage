NEWSAPI_KEY=

# Optional - only used if you wire an LLM into the orchestrator's routing
# or a natural-language summarizer (not required for the current logic,
# which is deterministic/rule-based).

LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

