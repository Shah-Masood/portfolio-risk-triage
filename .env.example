# (useful for demos/offline dev without burning API quota).

FORCE_OFFLINE=0

SEC_EDGAR_USER_AGENT=portfolio-risk-triage-demo you@example.com

ORCHESTRATOR_URL=http://localhost:8000
MARKET_RISK_URL=http://localhost:8001
CREDIT_RISK_URL=http://localhost:8002
CONCENTRATION_RISK_URL=http://localhost:8003
REGULATORY_RISK_URL=http://localhost:8004
